{
  "name": "dsh-plugin-title-suggest",
  "version": "0.1.0",
  "private": true,
  "description": "Suggest a conversation title generated by the current model, shown under the session-rename input.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["sessions", "slots"],
      "external": ["react"]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ]
}
